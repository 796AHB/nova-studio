# Copy to .env and fill in what you need. Everything here stays on the server.

# ---- Access ----
# Shared access token (simple single-user mode). Paste it in the app: Settings → Keys → Access token.
APP_TOKEN=change-me-to-a-long-random-string
# Accounts (recommended): create the first admin here, or in the app under Settings → Account.
# ADMIN_USER=ahmad
# ADMIN_PASSWORD=a-long-password
# ALLOW_SIGNUP=1            # let people create their own accounts (off by default)
# SESSION_DAYS=30
# USER_DAILY_LIMIT=200      # max AI requests per user per day through the server (0 = unlimited; admins are never limited)

# ---- Server ----
PORT=8787
# HOST=0.0.0.0
# DATA_DIR=./data           # accounts, synced data, share links, tasks (back this folder up!)
# RATE_LIMIT=120            # proxy requests per minute per user/IP
# API_RATE_LIMIT=300        # /api requests per minute per IP
# MAX_BODY_MB=50
# SYNC_MAX_MB=50
# ALLOW_ORIGINS=https://your-frontend.netlify.app   # only if the app is hosted on a different domain
# VAPID_SUBJECT=mailto:you@example.com              # contact for push notification services

# ---- Relay for the Web reader connector and MCP servers (blocks private/LAN addresses) ----
# RELAY=0
# RELAY_ALLOW_PRIVATE=1     # allow MCP servers on your LAN / localhost (trusted networks only)
# RELAY_MAX_MB=10

# ---- Provider keys (used for chat, scheduled tasks and the proxy) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
ELEVENLABS_API_KEY=
# Web search (Web search connector + "search the web first" in scheduled tasks)
TAVILY_API_KEY=
# Optional upstream overrides, e.g. OPENAI_BASE_URL=https://my-gateway.example.com/v1
